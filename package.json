{
  "private": true,
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "cd server && bun run build && cd ../plugin && bun run typecheck && bun run build && cd .. && bun run format:check"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
